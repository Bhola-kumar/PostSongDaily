# ---- General ----
OUTPUT_DIR=outputs
DAILY_LIMIT=6            # safety cap on jobs per day (you plan ~2/day)
MAX_BATCH_SIZE=5         # max number of videos accepted in one API request
API_KEY=                  # set a long random secret to require Bearer auth on /api/* (healthz stays public)
CLIP_SECONDS=30
FPS=24
MAX_SONG_TRIES=4         # how many ranked songs to try until one has lyrics
# FONT_PATH=assets/fonts/NotoSans-Bold.ttf   # needed for Hindi/Korean/etc. lyrics

# ---- ffmpeg ----
# Default: uses ./ffmpeg/ffmpeg(.exe) and ./ffmpeg/ffprobe(.exe) in the project root, then PATH.
# Override if your system blocks the bundled/PATH binary. Use an ffmpeg executable
# approved by your organization (file path or folder), then restart the app:
FFMPEG_PATH=C:/Users/Aman Kumar/Desktop/bhola/videogen/ffmpeg/ffmpeg.exe
FFPROBE_PATH=C:/Users/Aman Kumar/Desktop/bhola/videogen/ffmpeg/ffprobe.exe

# ---- Music (iTunes + Deezer need no key) ----
MUSIC_SOURCES=itunes,deezer,jamendo
ITUNES_COUNTRY=US
JAMENDO_CLIENT_ID=       # free key from developer.jamendo.com (royalty-free / CC tracks, full length)

# ---- Image generation (chain is tried in order) ----
IMAGE_PROVIDERS=pollinations,huggingface,procedural
POLLINATIONS_TOKEN=      # optional
HF_TOKEN=                # optional free HF token
HF_IMAGE_MODEL=black-forest-labs/FLUX.1-schnell
IMAGE_TIMEOUT=120

# ---- Title / description / tags ----
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash

# ---- Trending hashtags ----
# Providers are tried in order and the chain stops once enough tags are found, so Bright Data
# credits are only used when Trendgetter alone can't fill the list. Put brightdata first to prefer it.
TRENDING_PROVIDERS=trendgetter,brightdata,custom
TRENDING_CACHE_HOURS=12

# Trendgetter (free, no key): X trending hashtags + hashtags from trending TikTok videos
TRENDGETTER_BASE_URL=https://trendgetter.vercel.app
TRENDGETTER_COUNTRY=US            # TikTok country_code, e.g. IN, GB
TRENDGETTER_X_LOCATION=           # X trends location, empty = worldwide

# Bright Data hashtag scraper (free tier: 5K records/month). Needs BOTH values:
BRIGHTDATA_API_KEY=
BRIGHTDATA_DATASET_ID=            # gd_... id of the hashtag scraper, from brightdata.com/cp/datasets
BRIGHTDATA_SEED_TAGS=music,lyrics,viral
BRIGHTDATA_URL_TEMPLATE=https://www.tiktok.com/tag/{tag}
BRIGHTDATA_LIMIT_PER_INPUT=15     # records per hashtag; keeps credit use low
BRIGHTDATA_MAX_WAIT=120
# Full control over the scraper input instead of the template above, e.g.:
# BRIGHTDATA_INPUT_JSON=[{"url":"https://www.tiktok.com/tag/music"}]

# Your own endpoint returning JSON tags (optional third provider)
TRENDING_TAGS_URL=
TRENDING_TAGS_API_KEY=
TRENDING_TAGS_AUTH_HEADER=x-api-key
